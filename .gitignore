# ─── Node ───────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Env / 密钥（务必不要提交）────────────────────
.env
.env.*
.env.local
.env.*.local
!.env.example

# ─── 本地 Postgres 数据目录（不要上传数据库文件）──
.pg-local/
.pg-managed/

# ─── 运行时数据 / 备份 ─────────────────────────
# 静态参考数据（ICD-10 / 医院 / 配件 / 工伤标准）需提交到仓库以便 Render 部署；
# 运行时数据（demo-db / core-db / auxiliary-data 等）与备份仍保持忽略。
backend/data/*
!backend/data/icd10-db.json
!backend/data/hospital-db.json
!backend/data/parts-db.json
!backend/data/work-injury-standards.json
backups/

# ─── 构建产物 ───────────────────────────────────
frontend/dist/
backend/dist/

# ─── 编辑器 / OS ─────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ─── 测试产物 ───────────────────────────────────
coverage/
*.lcov
build-test/

# ─── Prisma ─────────────────────────────────────
backend/prisma/migrations/dev.db*

# ─── Logs ───────────────────────────────────────
*.log
logs/